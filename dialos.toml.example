# Copy to dialos.toml and edit.
mode = "solo"                 # "solo" or "multi"
instance_name = "Dialos"
bind = "127.0.0.1"
port = 8420
data_dir = "~/.local/share/dialos"
# system_prompt = ""
# model_allowlist = []        # empty = every model the backend reports
# default_model = ""
# model_choice = true         # false: users cannot pick; default_model is always used
# max_upload_bytes = 2147483648
# max_upload_bytes = 2147483648    # per file (uploads are chunked, so this is only a disk limit)
# user_quota_bytes = 21474836480   # per user, across all projects
# tools = true                     # let the model list/read/search a project's files
# context_tokens = 16384      # the model's window; history is fitted to ~75% of it (0 = send everything)
# think = true                # ask models to show reasoning
# log_enabled = true          # operator event log (timings, sizes; never message text)
# log_dir = ""                # default: <data_dir>/logs
# secure_cookies = true       # set when served over https (reverse proxy / tunnel)

[auth]
provider = "none"             # none | local | oidc | proxy
# oidc_issuer = "https://login.example.com"
# oidc_client_id = ""
# oidc_client_secret_env = "DIALOS_OIDC_SECRET"
# proxy_header = "X-Forwarded-Email"
# proxy_trusted_ips = ["127.0.0.1"]
# allow_signup = false

[backend]
kind = "auto"                 # auto | ollama | openai
url = "http://127.0.0.1:11434"
# api_key_env = ""
